#
# Local development environment managed by direnv.
#
# This file is committed to Git.
# Never place passwords, API keys, tokens, or credentials here.
# See docs/environment-variables/environment-variables.md for the full strategy.

# Load local application configuration and secrets from .env when it exists.
dotenv_if_exists .env


# ---------------------------------------------------------------------------
# Python local environment
# ---------------------------------------------------------------------------

# Make imports such as `from creditforge...` available when running scripts
# directly (not needed for `uv run`, which already resolves the src layout).
export PYTHONPATH="${PWD}/src${PYTHONPATH:+:${PYTHONPATH}}"

# Automatically use the project virtual environment without modifying the
# global shell configuration.
if [ -d "$PWD/.venv/bin" ]; then
  export VIRTUAL_ENV="$PWD/.venv"
  PATH_add "$VIRTUAL_ENV/bin"
fi


# ---------------------------------------------------------------------------
# Optional local defaults
# ---------------------------------------------------------------------------
# Prefer putting application configuration in .env.
# Uncomment only when these are shell-development settings rather than secrets.

# export ENVIRONMENT="development"
# export LOG_LEVEL="DEBUG"


# ===========================================================================
# FUTURE GCP / CLOUD RUN DEPLOYMENT REFERENCE
#
# Intentionally commented out.
# Keep this section for later deployment work.
# Uncomment and configure the complete group when Cloud Run work begins.
# ===========================================================================

# export GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
# export GOOGLE_CLOUD_REGION="asia-south1"
# export CLOUD_RUN_SERVICE="your-service-name"
# export ARTIFACT_REGISTRY_REPOSITORY="your-artifact-repository"
#
# export CLOUD_RUN_SERVICE_ACCOUNT="your-service-account@your-gcp-project-id.iam.gserviceaccount.com"
#
# export CONTAINER_IMAGE="${GOOGLE_CLOUD_REGION}-docker.pkg.dev/${GOOGLE_CLOUD_PROJECT}/${ARTIFACT_REGISTRY_REPOSITORY}/${CLOUD_RUN_SERVICE}"


# ---------------------------------------------------------------------------
# Future local GCP authentication
#
# These are commands for reference. Run them manually.
# Do not remove the comment markers.
# ---------------------------------------------------------------------------

# gcloud auth login
# gcloud auth application-default login
# gcloud config set project "$GOOGLE_CLOUD_PROJECT"
# gcloud config set run/region "$GOOGLE_CLOUD_REGION"


# ---------------------------------------------------------------------------
# Future Cloud Run deployment notes
# ---------------------------------------------------------------------------

# Cloud Run provides PORT automatically. The application must read PORT from
# the environment and should use 8000 as the local fallback (matches this
# project's `just dev` default via uvicorn).
#
# Use a dedicated Cloud Run service account for access to Google Cloud APIs.
#
# Do not deploy service-account JSON key files.
#
# Store passwords, API keys, access tokens, database credentials, and other
# sensitive values in Google Secret Manager.
#
# Configure ordinary non-secret values as Cloud Run environment variables.
#
# Do not copy the local .env file into the Docker image.

# ---------------------------------------------------------------------------
# Application (src/creditforge/core/config.py: Settings)
# ---------------------------------------------------------------------------

APP_NAME=creditforge
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql+asyncpg://creditforge:creditforge@localhost:5432/creditforge

# ---------------------------------------------------------------------------
# Future: LLM / Google ADK, Google Cloud
#
# Not read by the application yet — add here (and to Settings, and to this
# file's list) when they are actually wired up. See "Adding a new variable"
# in docs/environment-variables/environment-variables.md.
# ---------------------------------------------------------------------------

# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_REGION=asia-south1
